schema_version = "1.0"
source = "github"
classification_fields = ["role", "observation_scopes", "capabilities", "detection_methods"]

# Starter ratings copied from representative saved pipeline rows so the format is executable.
# Review these values manually before treating them as authoritative human ground truth.

[[entities]]
repository = "OISF/suricata"
decision = "accept"
role = "standalone_detector"
observation_scopes = ["network"]
capabilities = ["detection", "prevention", "monitoring"]
detection_methods = ["signature_based", "rule_based", "protocol_analysis", "packet_analysis", "flow_analysis"]

[[entities]]
repository = "snort3/snort3"
decision = "accept"
role = "standalone_detector"
observation_scopes = ["network"]
capabilities = ["detection", "prevention"]
detection_methods = ["signature_based", "rule_based", "packet_analysis", "protocol_analysis"]

[[entities]]
repository = "zeek/zeek"
decision = "accept"
role = "platform_framework"
observation_scopes = ["network"]
capabilities = ["monitoring", "detection"]
detection_methods = ["protocol_analysis", "rule_based"]

[[entities]]
repository = "wazuh/wazuh"
decision = "accept"
role = "platform_framework"
observation_scopes = ["host_endpoint", "network", "application", "database", "provenance"]
capabilities = ["detection", "prevention", "response", "monitoring"]
detection_methods = ["signature_based", "rule_based", "anomaly_based", "integrity_based", "log_analysis", "system_call_analysis", "threat_intelligence_based", "hybrid"]

[[entities]]
repository = "Mmohet/EfficiencyTool"
decision = "exclude"
role = "out_of_scope"
observation_scopes = ["host_endpoint"]
capabilities = ["monitoring"]
detection_methods = ["unknown"]

[[entities]]
repository = "ossec/ossec-hids"
decision = "accept"
role = "standalone_detector"
observation_scopes = ["host_endpoint"]
capabilities = ["detection", "prevention", "response", "monitoring"]
detection_methods = ["hybrid"]

[[entities]]
repository = "stamparm/maltrail"
decision = "accept"
role = "standalone_detector"
observation_scopes = ["network"]
capabilities = ["detection"]
detection_methods = ["signature_based", "anomaly_based", "threat_intelligence_based", "hybrid"]

[[entities]]
repository = "Azure/Azure-Sentinel"
decision = "accept"
role = "rules_content"
observation_scopes = ["multi_scope"]
capabilities = ["detection"]
detection_methods = ["query_based"]

[[entities]]
repository = "1N3/Sn1per"
decision = "exclude"
role = "out_of_scope"
observation_scopes = ["unknown"]
capabilities = ["monitoring"]
detection_methods = ["unknown"]

[[entities]]
repository = "sbilly/awesome-security"
decision = "exclude"
role = "out_of_scope"
observation_scopes = ["unknown"]
capabilities = []
detection_methods = ["unknown"]
