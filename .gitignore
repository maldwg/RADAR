__pycache__/
*.py[cod]
*.egg-info/
.cache/
data/raw/*.sqlite3
data/raw/**/*.sqlite3
data/raw/**/*.sqlite3-*
artifacts/plots/**
artifacts/runs/
**/*.log
**/*.csv
**/*.svg
**/*.pdf

# Rated evaluation reports are versioned research artifacts. Keep their figures
# and companion tables visible after the evaluation tree is regenerated.
!artifacts/evaluation/**/*.csv
!artifacts/evaluation/**/*.svg
!artifacts/evaluation/**/*.pdf
